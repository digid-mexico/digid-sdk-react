{
  "name": "@digid-sdk/firma-autografa-react",
  "version": "1.0.2",
  "description": "SDK React para el flujo de firma autógrafa de Digid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digid-mexico/digid-sdk-react.git"
  },
  "homepage": "https://github.com/digid-mexico/digid-sdk-react#readme",
  "bugs": {
    "url": "https://github.com/digid-mexico/digid-sdk-react/issues"
  },
  "author": "CONSTANCIAS DIGITALES",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "digid",
    "firma",
    "autografa",
    "react",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "require": {
        "types": "./dist/engine.d.cts",
        "default": "./dist/engine.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "scan-assets",
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config playground/vite.config.ts",
    "dev:movil": "DIGID_DEV_HTTPS=1 vite --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.0",
    "pdfjs-dist": "^4.5.136",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.0.0",
    "msw": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
